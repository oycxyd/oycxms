    %         mean_specs(n,:) = mean(data);
    %     else
    %         [data]=h5toMat([filename,'\datacube_aligned.h5']);
    %         percentage = 10;
    %         sample_size = ceil(size(data,1)*percentage/100);
    %         idx = randi(sample_size,[1 sample_size]);
    %         data_m = data(idx,:);
    %         specs_aligned = cat(1,specs_aligned,data_m);
    %         mean_specs(n,:) = mean(data);
