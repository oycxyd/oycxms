function [mean_specs,mzlens,errors] = check_dtwa(varargin)
%% check before alignment
    if isempty(varargin)
        dname = uigetdir();
        cd (dname);
        filenames=[dir('*.raw');dir('*.imzml')];
    end
    % mean_specs = [];
    mean_specs = {};
    mzlens = [];
    errors = {};
    parfor n = 1:length(filenames)
        % disp(['checking mean spec from file ',num2str(n),'/',num2str(length(filenames))])
        filename = filenames(n).name;
        try
            [data,~,mz]=h5toMat([filename,'\datacube.h5']);
            mean_specs{n} = cat(1,mz,mean(data));
            mzlens(n) = length(mz);
        catch
            warning([filename,' has not been pre-processed!'])
            errors{n,1} = filename;
        end
    end
    errors = errors(~cellfun('isempty',errors));
    filt = find(mzlens < median(mzlens)/3);
    figure,scatter(1:length(mzlens),mzlens)
    hold on
    scatter(filt,mzlens(filt))

    bad = filenames(filt);
    badname = bad(1).name;
    movefile(badname,newFolder)
%% check after alignment
    % tic
    % specs_aligned = [];
