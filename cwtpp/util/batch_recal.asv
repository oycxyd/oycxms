function batch_recal(varargin)
    dname = uigetdir();
    %my dir, it will just go to root if this folder doesn't exist
    cd (dname);
    filenames=[dir('*.raw');dir('*.imzml')];
    
    mzs_recal = {};
    ppms = [];
    if isempty(varargin)
        threshold = 300;%ppm
    else
        threshold = varargin{2};
    end

    for i = 1:length(filenames)

    

    
    for i = 1:length(mzs)
    % for i = 1:5
        disp(i)
        [mzs_recal{i},ppm] = MSrecal(mzs{i},references, threshold);
        ppms(i) = mean(ppm);
    end
    
    select = (ppms<=threshold);
    mzs_recal = mzs_recal(select);
end
