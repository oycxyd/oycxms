   "source": [
    "## *Mann-Whitney test (non-parametric binary problem)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## KW test = MW test for a two-way comparison~"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "metadata": {},
   "outputs": [],
   "source": [
    "p_vals_MW=np.zeros(len(mz))\n",
    "for i in range(len(mz)):\n",
    "#     print(i)\n",
    "    if (np.round(np.mean(green_data.iloc[:,i]),4))== (np.round(np.mean(red_data.iloc[:,i]),4)):\n",
    "        p_vals_MW[i]=1\n",
    "    else:\n",
    "        dum1=stats.mannwhitneyu(green_data.iloc[:,i],red_data.iloc[:,i])\n",
    "        dum2=dum1.pvalue\n",
    "        p_vals_MW[i]=(dum2)"
   ]
